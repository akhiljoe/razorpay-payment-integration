{
  "app": "python app.py",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/__init__.py",
      "**/*.pyc",
      ".venv/**",
      "cdk.out/**",
      "**/.pytest_cache/**"
    ]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"],
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-ecr-assets:dockerIgnoreSupport": true,
    "@aws-cdk/aws-secretsmanager:useAttachedSecretResourcePolicyForSecretTargetAttachments": true,
    "@aws-cdk/aws-redshift:columnId": true,
    "@aws-cdk/aws-stepfunctions-tasks:enableLogging": true,
    "@aws-cdk/aws-ec2:launchTemplateDefaultUserData": true,
    "@aws-cdk/aws-sns-subscriptions:restrictSqsDescryption": true,
    "razorpay:env": {
      "dev": {
        "account": "111111111111",
        "region": "ap-south-1"
      },
      "prod": {
        "account": "222222222222",
        "region": "ap-south-1"
      }
    },
    "razorpay:ops_email": "REPLACE_WITH_OPS_EMAIL@example.com",
    "razorpay:budget_thresholds_usd": [5, 25, 50],
    "razorpay:domain": {
      "dev": {
        "api": "api.dev.example.com",
        "widget": "widget.dev.example.com",
        "tenant_origins": ["https://dev.example.com"]
      },
      "prod": {
        "api": "api.example.com",
        "widget": "widget.example.com",
        "tenant_origins": ["https://example.com"]
      }
    },
    "razorpay:features": {
      "_comment": "All deferred services. Flip a flag and cdk deploy to enable. See designs/MIGRATION_ARCHITECTURE.md 'Deferred Services Enablement Guide'.",
      "waf_enabled": false,
      "provisioned_concurrency_enabled": false,
      "inspector_enabled": false,
      "config_enabled": false,
      "guardduty_enabled": false,
      "security_hub_enabled": false,
      "rds_in_vpc_enabled": false,
      "aurora_global_db_enabled": false
    }
  }
}
