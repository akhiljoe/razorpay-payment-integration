# Database
DATABASE_URL=postgresql://razorpay:razorpay@localhost:5432/razorpay_checkout

# AWS / LocalStack
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Razorpay tenant config (per-tenant overrides via TenantConfigRegistry)
RAZORPAY_TENANT_ID=t_dev
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_MODE=test
RAZORPAY_DB_DSN=postgresql://razorpay:razorpay@localhost:5432/razorpay_checkout
RAZORPAY_POOL_MIN_SIZE=2
RAZORPAY_POOL_MAX_SIZE=10
RAZORPAY_RAZORPAY_API_TIMEOUT=10.0

# Observability
RAZORPAY_OTEL_EXPORTER=stdout
RAZORPAY_OTEL_ENDPOINT=

# Admin
RAZORPAY_ADMIN_API_KEY=

# Dev-only routes (RAZORPAY_DEV_ROUTES_ENABLED)
#
# When set to "true" the FastAPI dev backend exposes the /dev/* routes:
#   /dev/dashboard, /dev/shop, /dev/test-page, /dev/widget.js,
#   /dev/flow*, /dev/queues, /dev/simulate, /dev/reset, /dev/dashboard-data.
#
# These include destructive endpoints (/dev/reset wipes the DB) and the
# /dev/simulate that signs a webhook with the tenant's secret. They MUST
# be disabled (the default) in any deployment reachable from the internet.
#
# Local development: set to "true" in example/backend/.env
# Production:        leave unset OR explicitly set to "false"
RAZORPAY_DEV_ROUTES_ENABLED=true
