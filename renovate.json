{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "schedule:weekly"
  ],
  "timezone": "Asia/Kolkata",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "schedule": ["at any time"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group OpenTelemetry packages",
      "matchPackagePatterns": ["^opentelemetry"],
      "groupName": "opentelemetry"
    },
    {
      "description": "Group AWS CDK ecosystem",
      "matchPackagePatterns": ["^aws-cdk", "^@aws-cdk"],
      "matchPackageNames": ["constructs", "cdk-nag"],
      "groupName": "aws-cdk"
    },
    {
      "description": "Group boto3 family (Python + types stubs)",
      "matchPackageNames": ["boto3", "aioboto3", "botocore", "types-boto3"],
      "groupName": "boto3"
    },
    {
      "description": "Group pytest family",
      "matchPackagePatterns": ["^pytest"],
      "groupName": "pytest"
    },
    {
      "description": "Group FastAPI + Pydantic ecosystem",
      "matchPackageNames": ["fastapi", "pydantic", "pydantic-settings", "starlette"],
      "groupName": "fastapi-pydantic"
    },
    {
      "description": "Auto-merge patch updates after CI passes",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "description": "Pin GitHub Actions to commit SHA for supply-chain safety",
      "matchManagers": ["github-actions"],
      "pinDigests": true,
      "groupName": "github-actions"
    },
    {
      "description": "Hold major version bumps for explicit review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-bump", "review-required"]
    },
    {
      "description": "Razorpay's Razorpay SDK and webhook libs: manual review only",
      "matchPackageNames": ["razorpay"],
      "automerge": false,
      "labels": ["dependencies", "review-required", "razorpay"]
    },
    {
      "description": "asyncpg: manual review (binary wheel + DB protocol)",
      "matchPackageNames": ["asyncpg"],
      "automerge": false,
      "labels": ["dependencies", "review-required", "database"]
    }
  ],
  "pip_requirements": {
    "fileMatch": ["(^|/)razorpay_checkout/pyproject\\.toml$", "(^|/)infra/pyproject\\.toml$"]
  },
  "npm": {
    "fileMatch": ["(^|/)packages/checkout-widget/package\\.json$"]
  }
}
